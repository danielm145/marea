# Copiar a .env (gitignored, NUNCA se sube):   cp .env.example .env
# Luego:  scripts/conectar.sh   (publica, conecta Vertex y deja la base lista con tu usuario de admin)

# — Supabase: proyecto COMPARTIDO `fieldbuilt-lab`. La app vive en el esquema `marea` (no toca public). —
# supabase.com → proyecto fieldbuilt-lab → Project Settings → General → Project ID
SUPABASE_PROJECT_REF=
# (opcional: sale sola del Project ID)
SUPABASE_URL=
# Project Settings → API Keys → anon / public   (es pública: la usa la app)
SUPABASE_ANON_KEY=
# Project Settings → API Keys → service_role   (SECRETA: solo para scripts, jamás al navegador)
SUPABASE_SERVICE_ROLE_KEY=
# supabase.com → tu cuenta (arriba a la derecha) → Access Tokens → Generate new token   (empieza con sbp_)
SUPABASE_ACCESS_TOKEN=

# — Tu usuario de admin (entras con el celular y la clave = día y mes de tu cumpleaños) —
ADMIN_NOMBRE=Daniel Martínez
ADMIN_CELULAR=
# día/mes, ej. 07/03
ADMIN_CUMPLE=

# — Vertex (opcional): ruta al JSON de la cuenta de servicio de Google, si scripts/ia.sh no la encuentra solo —
VERTEX_SA_JSON=

# — Opcional: solo si quieres además las funciones viejas que leen con Claude (la IA principal es Vertex) —
ANTHROPIC_API_KEY=
